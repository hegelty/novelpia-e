<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:style/Theme.Holo.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">#FFFFFF</item>
        <item name="android:colorBackground">#FFFFFF</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:colorAccent">#000000</item>
        <item name="android:textColorPrimary">#111111</item>
        <item name="android:textColorSecondary">#444444</item>
        <item name="android:windowTitleStyle">@style/PlainWindowTitle</item>
    </style>
    <style name="PlainWindowTitle" parent="android:style/TextAppearance.Holo.DialogWindowTitle">
        <item name="android:textColor">#111111</item>
    </style>
</resources>
